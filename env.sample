# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Bot Settings
BOT_NAME=Personal Support Bot
BOT_DESCRIPTION=A simple bot that echoes messages with random emojis

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Development Settings
DEBUG=false
ENVIRONMENT=production

# Optional: Webhook settings (for production deployment)
# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_PORT=8443
# WEBHOOK_LISTEN=0.0.0.0
# WEBHOOK_SSL_CERT=path/to/cert.pem
# WEBHOOK_SSL_PRIV=path/to/private.key